{
  "schemaVersion": 1,
  "monitoring": {
    // Собственный мониторинг Booster. docs/PRINCIPLES.md: не чаще раза в 1–2 с; меньше 1000 мс поднимается до 1000.
    "selfUsageIntervalMs": 2000,
    // Опрос счётчиков GPU Engine во время замера FPS — определяет адаптер, на котором рисует игра.
    "gpuEngineSampleIntervalMs": 2000,
    // Опрос имён процессов для обнаружения игры; процессы не открываются. Опрос идёт только при подготовленной
    // сессии или автозапуске; запуск игры замечается не позже чем через 2 с. Меньше 1000 мс поднимается до 1000.
    "gameDetectionIntervalMs": 2000,
    // Датчики GPU и CPU — раз в 2 с: правило «мониторинг не чаще раза в 1–2 секунды»; чтение NVAPI
    // и счётчиков занимает десятки миллисекунд. Меньше 1000 мс поднимается до 1000.
    "sensorIntervalMs": 2000,
    // Игра считается завершённой после стольких замеров подряд без её процесса. Один неудачный замер
    // (процесс на мгновение недоступен для чтения времени старта) не должен завершать сессию;
    // 2 замера при опросе раз в 2 с — задержка восстановления до 4 с. Допустимо 1–10.
    "gameExitConfirmationCount": 2
  },
  "detectors": {
    // WMI-запросы инвентаризации на исправной системе занимают доли секунды; 15 с — запас для медленных систем.
    "defaultTimeoutMs": 15000,
    "timeoutsMs": {
      // Win32_PnPSignedDriver перечисляет все драйверы и на части систем выполняется десятки секунд.
      "drivers": 90000,
      // Автозагрузка: пять ключей Run и RunOnce с их StartupApproved, две папки и разбор ярлыков через COM — обычно доли секунды. 10 с — запас
      // на медленный диск; дольше ждать не стоит: секция не главная, и без неё остальная диагностика полна.
      "startup": 10000,
      // Игровые настройки: два значения HKCU — мгновенно; 5 с хватит с запасом даже при занятом реестре.
      "gaming": 5000,
      // HAGS: одно значение HKLM — мгновенно; 5 с с запасом.
      "hags": 5000
    }
  },
  "presentMon": {
    // null — искать в %LOCALAPPDATA%\Booster\tools\PresentMon и рядом с Booster.App.exe.
    "executablePath": null,
    "sessionName": "BoosterCapture"
  },
  // Серия бенчмарка: повторные прогоны одной сцены. Вся серия — один запуск PresentMon (один запрос UAC).
  "benchmark": {
    // Медиана трёх прогонов устойчива к одному выбросу; по двум не отличить выброс от закономерности. Допустимо 1–10.
    "runCount": 3,
    // При 60 FPS — 1800 кадров: 1% low опирается на 18 самых долгих. Дольше — серия утомляет, и прогоны меньше
    // похожи друг на друга. Допустимо 10–600.
    "runSeconds": 30,
    // Время вернуться к началу сцены между прогонами; 0 — прогоны подряд. Допустимо 0–300.
    "pauseSeconds": 10,
    // Время переключиться в игру после запуска PresentMon и запроса UAC. Допустимо 3–300.
    "startDelaySeconds": 10,
    // Окно Booster во время игры не видно: начало и конец прогона отмечаются коротким звуком.
    "soundCues": true,
    // Файл серии — единицы КБ; 100 серий — несколько недель сравнений.
    "retainedSeriesCount": 100,
    // Метрики кадров игровой сессии (collectFrameMetrics) — первые 5 минут: при 144 FPS это около 10 МБ CSV,
    // а за многочасовую сессию вышли бы сотни МБ. Допустимо 30–1800.
    "sessionCaptureSeconds": 300
  },
  // Число дневных файлов логов, которые хранятся на диске.
  "logging": { "retainedFileCount": 14 },
  // Число хранимых завершённых игровых сессий; незавершённые не удаляются. 50 — около месяца ежедневной игры,
  // файл сессии — несколько КБ.
  "journal": { "retainedSessionCount": 50 },
  // Системная диагностика (экран «Система» и отчёт).
  "diagnostics": {
    // Две недели журнала: видно повторяющиеся сбои, но не события давно исправленных проблем. Допустимо 1–90.
    "stabilityDays": 14,
    // Предел чтения журнала: при «шторме» ошибок диска за период их могут быть десятки тысяч. Читаются самые новые,
    // в отчёте видна пометка. Допустимо 10–5000.
    "maxStabilityEvents": 500,
    // Длина списков процессов по памяти и вводу-выводу. Допустимо 3–50.
    "topProcessCount": 10,
    // Фоновая активность на экране «Система» — только пока экран открыт, раз в 2 с: правило «мониторинг не чаще
    // раза в 1–2 секунды». Меньше 1000 мс поднимается до 1000.
    "activityIntervalMs": 2000
  },
  // Тест сети — только по кнопке на экране «Система»: эхо-запросы (ICMP) к шлюзу и, если задан, к узлу host.
  "network": {
    // 30 раундов раз в секунду — полминуты: хватает для медианы и джиттера, потери 1 из 30 уже видны. Допустимо 5–600.
    "pingCount": 30,
    // Допустимо 200–10000 мс.
    "pingIntervalMs": 1000,
    // Ответ позже секунды для игры равен потере. Допустимо 100–5000 мс.
    "pingTimeoutMs": 1000,
    // Внешний узел (имя или IP-адрес), например сервер игры. null — только шлюз: Booster не выбирает
    // сторонний сервер за пользователя.
    "host": null
  },
  // Сеть в игре — замер по кнопке на экране «Система»: события ядра (ETW) только на время замера, ICMP к шлюзу,
  // узлам маршрута и серверу игры.
  "gameNetwork": {
    // Фоновый поиск Wi-Fi повторяется примерно раз в 60 с; за 180 с период успевает повториться трижды. Допустимо 30–1800.
    "measureSeconds": 180,
    // Игра шлёт обновления 20–128 раз в секунду; за 10 с у сервера набираются сотни событий. Допустимо 3–60.
    "serverDetectSeconds": 10,
    // Как у tracert. Допустимо 5–64.
    "traceMaxHops": 30,
    // Как у tracert. Допустимо 1–5.
    "traceProbesPerHop": 3,
    // Пять молчащих узлов подряд — дальше ответов почти наверняка не будет; при 3 пробах по секунде это 15 с ожидания.
    // Допустимо 2–30.
    "traceStopAfterSilentHops": 5,
    // Примерно как у тестов bufferbloat: спокойный фон, затем загрузка. Допустимо 10–120.
    "loadIdleSeconds": 20,
    // Допустимо 10–120.
    "loadSeconds": 30,
    // Ограничение памяти: на ПК за 3 минуты обычно сотни пар «процесс — адрес». Допустимо 256–65536.
    "maxTrackedFlows": 4096
  }
}
