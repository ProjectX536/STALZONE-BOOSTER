{
  "schemaVersion": 1,
  // При N < 300 1% low опирается меньше чем на 3 кадра и определяется единичным выбросом.
  "minimumFramesForMetrics": 300,
  // Эвристика для замечания, а не измеренный порог производительности: при меньшем запасе на томе
  // могут не помещаться обновления Windows, кэш шейдеров и файл подкачки.
  "lowFreeSpacePercent": 10,
  // Оценка снижения частоты GPU по датчикам (троттлинг).
  "throttle": {
    // Запас к пределу температуры, о котором сообщает драйвер (TemperatureWarning — «с этого уровня начинается
    // троттлинг по температуре»): датчик отдаёт целые градусы, а замер раз в 2 с усредняет пики.
    "temperatureMarginC": 2,
    // GPU занят не меньше 90% времени — драйвер держит частоту у верхней границы буста. При меньшей загрузке
    // снижение частоты — штатное энергосбережение, а не троттлинг.
    "gpuBusyUtilizationPercent": 90,
    // Буст-частота колеблется на несколько процентов от температуры и напряжения; падение больше 10% от максимума
    // того же прогона под нагрузкой — заметное снижение.
    "clockDropPercent": 10,
    // 20 с при опросе раз в 2 с: на меньшем числе замеров сравнивать частоты не с чем.
    "minimumSamples": 10,
    // Окно оценки в игровой сессии — 1 минута при опросе раз в 2 с: короткие пики не дают вывода, длинное окно запаздывает.
    "sessionWindowSamples": 30
  },
  // Рывок — интервал, который выбивается из соседних (docs/ARCHITECTURE.md, раздел 10).
  "stutter": {
    // Вдвое длиннее соседних: кадр показан вместо двух подряд.
    "factor": 2.0,
    // На высоких FPS удвоение 3 -> 6 мс незаметно; 8 мс — половина кадра при 60 Гц.
    "minimumExcessMs": 8,
    // Полсекунды при 60 FPS (по 15 кадров до и после): медиана следует за сменой сцены, но не за единичным рывком.
    "windowFrames": 30
  },
  // Сигналы анализа ограничений. Доли кадра — от 0 до 1 (медиана по кадрам), загрузка — в процентах.
  "bottleneck": {
    // GPU занят не меньше 90% времени кадра (MsGPUBusy / интервал) — ждёт работу меньше 10% кадра.
    "gpuBoundFrameShare": 0.90,
    // Как throttle.gpuBusyUtilizationPercent: при такой загрузке драйвер держит частоту у верхней границы.
    "gpuBusyPercent": 90,
    // GPU простаивает четверть кадра и больше — недогружен.
    "gpuIdleFrameShare": 0.75,
    "gpuIdlePercent": 75,
    // Поток занимает логический CPU почти полностью; оставшееся — ожидание синхронизации.
    "busyThreadPercent": 90,
    "systemCpuPercent": 90,
    // Только поддерживающий сигнал: MsCPUBusy включает сон ограничителя кадров (на захвате при 24 FPS CPUBusy был
    // 41,5 из 41,7 мс при GPUBusy 1,2 мс).
    "cpuBoundFrameShare": 0.90,
    // Средний FPS у частоты дисплея с учётом неточной частоты (59,94 вместо 60) и пропусков кадров.
    "refreshTolerancePercent": 3,
    // V-Sync включён почти для всех кадров (SyncInterval не меньше 1).
    "syncedFrameShare": 0.90,
    // P95/P50 не больше 1,15: кадры почти одинаковой длины — похоже на ограничитель кадров.
    "uniformFrameTimeRatio": 1.15,
    // Бюджет видеопамяти почти исчерпан: драйвер начинает вытеснять ресурсы в системную память.
    "vramUsedPercent": 90,
    // Меньше 10% свободной памяти: Windows начинает урезать рабочие наборы процессов.
    "availableMemoryPercent": 10,
    // У предела выделения памяти: новые выделения требуют роста файла подкачки или завершаются ошибкой.
    "commitPercent": 90,
    // Эвристика, уточняется по данным: устойчивые сотни чтений страниц с диска в секунду во время игры — активная подкачка.
    "pageReadsPerSecond": 100,
    "diskBusyPercent": 90,
    // Для SSD — в десятки раз больше обычного, для HDD — очередь запросов.
    "diskLatencyMs": 50,
    // Рывок каждые 10 с заметен постоянно.
    "stuttersPerMinute": 6,
    // P99 вдвое длиннее медианы — время кадра заметно неровное.
    "percentileRatio": 2.0,
    // Пик Processor(_Total)\% DPC Time и % Interrupt Time за секунду серии. Это доля всех логических CPU: на исправной
    // системе — доли процента. 2% на 16 потоках — треть одного ядра, а DPC обычно выполняются на одном ядре, так что
    // заметная нагрузка на ядро здесь сильно разбавлена. Эвристика, уточняется по данным; вывод — только «запишите трассу».
    "dpcTimePercent": 2,
    "interruptTimePercent": 2
  },
  // Сравнение серий.
  "comparison": {
    // По одному прогону разброс неизвестен — вывода «лучше» или «хуже» нет.
    "minimumRuns": 2,
    // Разница меньше 3% обычно в пределах разброса повторов одной сцены.
    "minimumChangePercent": 3,
    // Разброс среднего FPS между прогонами больше 5% — условия прогонов различались.
    "runVariationPercent": 5,
    "minimumStutterChangePerMinute": 1
  },
  "recommendations": {
    // Фоновый процесс, занимающий 5% всех логических CPU, — заметная доля на 8–16 потоках.
    "backgroundCpuPercent": 5
  },
  // Рекомендации по снимку системы (экран «Система»).
  "memory": {
    // Как bottleneck.commitPercent, но в покое: уже без игры выделено 90% предела — игре не хватит места
    // без роста файла подкачки.
    "commitPercent": 90
  },
  // Тест сети. Сеть не влияет на FPS: эти пороги — о рывках в сетевых играх, а не о частоте кадров.
  "network": {
    // Проводная домашняя сеть отвечает за 1–2 мс, Wi-Fi — за единицы мс; 10 мс до своего роутера — перегруженный
    // или слабый канал.
    "gatewayLatencyMs": 10,
    // Эвристика для сетевых игр: при задержке от 100 мс до сервера действия заметно запаздывают.
    "hostLatencyMs": 100,
    // Изменение задержки на 10 мс между соседними ответами — неровная доставка, которую игра сглаживает
    // увеличением буфера.
    "jitterMs": 10,
    // Даже 1% потерь заметен в сетевой игре как пропуски и откаты позиции.
    "lossPercent": 1
  },
  // Сеть в игре. Пороги диагностируют, где возникает задержка, и не обещают её снижения.
  "gameNetwork": {
    // Игры шлют 20–128 обновлений в секунду; фоновые соединения — меньше одного события в секунду. Голосовой чат
    // (~50 пакетов в секунду) порог тоже проходит, поэтому показываются три кандидата.
    "minGameEventsPerSecond": 10,
    // Меньшие отклонения — обычный джиттер Wi-Fi, в игре почти не заметны.
    "spikeMinDeltaMs": 30,
    // 5 MAD ≈ 3,4σ для нормального шума: случайный выброс такой величины редок.
    "spikeMadFactor": 5,
    // Три события дают два интервала — минимум, чтобы говорить о периоде.
    "periodicMinSpikes": 3,
    // Фоновый поиск идёт раз в ~60 с с разбросом в секунды; 20 % — это ±12 с.
    "periodicMaxVariation": 0.2,
    // Роутеры отвечают на ICMP с задержкой в единицы мс; рост на 20 мс, который держится до конца маршрута, — уже
    // участок маршрута, а не шум.
    "routeJumpMs": 20,
    // Шкала DSLReports, её использует тест Waveform (https://www.waveform.com/tools/bufferbloat): A+ < 5, A < 30,
    // B < 60, C < 200, D < 400, иначе F. Совет даётся с оценки C.
    "bufferbloatGradesMs": [5, 30, 60, 200, 400],
    // Меньше 5 Мбит/с суммарно — канал почти наверняка не загружен, замер под нагрузкой не засчитывается.
    "loadMinThroughputMbps": 5,
    // Игра сама тратит 5–30 КБ/с; 100 КБ/с ≈ 0,8 Мбит/с — на исходящем канале 10–20 Мбит/с это уже заметная очередь.
    "backgroundTrafficKBps": 100,
    // Производители оборудования Wi-Fi (Cisco, Aruba) называют −67 dBm минимумом для голоса и видео в реальном времени.
    "wifiWeakSignalDbm": -67,
    // Как у бенчмарка.
    "comparisonMinimumRuns": 2,
    // Медиана пинга между повторами одного маршрута гуляет на 1–2 мс.
    "comparisonMinimumChangeMs": 3,
    "comparisonMinimumChangePercent": 10
  },
  // Автозагрузка: порог только помечает тяжёлые элементы и даёт по ним рекомендацию (то, что сейчас запущено и потребляет
  // ресурсы). Кнопкой «Отключить» пользователь может выключить любой элемент, кроме защиты и античита.
  "startup": {
    // Меньше 50 МБ частной памяти держат мелкие фоновые утилиты (значки в трее, помощники обновлений); их отключение
    // почти не освобождает ресурсов и не стоит риска потерять нужную функцию.
    "minPrivateMemoryMb": 50
  }
}
