<Project Sdk="Microsoft.NET.Sdk">
  <!-- Только read-only тесты и разбор данных (docs/PRINCIPLES.md, «Безопасность машины разработчика»). Тесты на живой системе помечены Category=Host. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Booster.Platform.Windows\Booster.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Один ListLogger на оба тестовых проекта. -->
    <Compile Include="..\Booster.Core.Tests\TestSupport\ListLogger.cs" Link="TestSupport\ListLogger.cs" />
    <Compile Include="..\Booster.Core.Tests\TestSupport\FakeConfiguration.cs" Link="TestSupport\FakeConfiguration.cs" />
    <Compile Include="..\Booster.Core.Tests\TestSupport\SampleSeries.cs" Link="TestSupport\SampleSeries.cs" />
    <None Include="Fixtures\**\*.json;Fixtures\**\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\**" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
