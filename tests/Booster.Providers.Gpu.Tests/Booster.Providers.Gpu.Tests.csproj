<Project Sdk="Microsoft.NET.Sdk">
  <!-- Провайдеры GPU на фейках источников Platform; вендорские библиотеки не загружаются. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Booster.Providers.Gpu\Booster.Providers.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Booster.Platform.Windows.Tests\TestSupport\FakeFileProbe.cs" Link="TestSupport\FakeFileProbe.cs" />
    <None Include="..\..\config\**" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
