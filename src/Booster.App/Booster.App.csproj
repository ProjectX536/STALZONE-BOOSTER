<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!--
    Релиз: dotnet publish src/Booster.App/Booster.App.csproj -c Release -r win-x64 — один exe со средой .NET, установка .NET не нужна.
    Конфигурация из config\ упакована в exe и распаковывается при запуске, поэтому читается так же, как рядом с exe.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- Тесты собирают корень композиции (AppHost) во временном каталоге. -->
    <InternalsVisibleTo Include="Booster.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Booster.Core\Booster.Core.csproj" />
    <ProjectReference Include="..\Booster.Platform.Windows\Booster.Platform.Windows.csproj" />
    <ProjectReference Include="..\Booster.Providers.Gpu\Booster.Providers.Gpu.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Класс Strings генерируется при сборке; в репозитории только .resx. Публичный — для x:Static в XAML. -->
    <EmbeddedResource Update="Resources\Strings.resx" Generator="MSBuild:Compile"
                      StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="Booster.App.Resources" StronglyTypedClassName="Strings" PublicClass="true" />
  </ItemGroup>
  <!--
    Разметку с локальными типами WPF компилирует через временную сборку (*_wpftmp.csproj), а в её сборке нет шага ResGen,
    и класса Strings там нет. Генерация перед CoreCompile добавляет его и во временную сборку; в основной CoreResGen
    к этому моменту уже выполнен, и цель ничего не делает.
  -->
  <Target Name="GenerateStringsForMarkupCompilation" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResourceNames;CoreResGen" />
  <ItemGroup>
    <!-- Встроенная конфигурация из репозитория копируется в config\ рядом с exe. -->
    <None Include="..\..\config\**" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
