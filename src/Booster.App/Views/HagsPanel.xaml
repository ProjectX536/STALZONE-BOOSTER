<UserControl x:Class="Booster.App.Views.HagsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <!-- A/B-тест HAGS: Booster только открывает «Параметры» и сравнивает две серии; переключает HAGS пользователь -->
  <StackPanel>
    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.HagsTitle}" />
    <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.HagsHint}" />
    <TextBlock Text="{Binding CurrentText}" Margin="0,8,0,0" />
    <TextBlock Text="{Binding StepText}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,4,0,0" />
    <Border HorizontalAlignment="Left" Margin="0,8,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding VerdictText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock TextWrapping="Wrap" MaxWidth="600" Text="{Binding VerdictText}" />
    </Border>
    <WrapPanel Margin="0,4,0,4">
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.HagsStart}" Command="{Binding StartExperimentCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.HagsOpenSettings}" Command="{Binding OpenGraphicsSettingsCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.HagsCheck}" Command="{Binding CheckCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.HagsTakeCandidate}" Command="{Binding TakeCandidateCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.HagsReset}" Command="{Binding ResetCommand}" />
    </WrapPanel>
    <TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,16" />
  </StackPanel>
</UserControl>
