<UserControl x:Class="Booster.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,16,24,4">
      <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavOverview}" />
      <WrapPanel Margin="0,0,0,8">
        <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Refresh}" Command="{Binding RefreshCommand}" />
        <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding RefreshCancelCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CancelRefresh}"
                Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
        <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.ExportReport}" Command="{Binding ExportCommand}" />
        <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding ExportCancelCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CancelExport}"
                Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
      </WrapPanel>
      <ProgressBar IsIndeterminate="True" Height="4" Width="320" HorizontalAlignment="Left" Margin="0,0,0,6"
                   Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
      <TextBlock Style="{StaticResource Hint}" Text="{Binding SnapshotText}" />
      <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SummaryTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SourceHint}" Margin="0,0,0,6" />
        <ContentPresenter Content="{Binding Summary}" HorizontalAlignment="Left" />
        <ContentPresenter Content="{Binding Findings}" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
