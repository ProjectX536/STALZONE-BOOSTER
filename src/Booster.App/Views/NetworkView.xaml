<UserControl x:Class="Booster.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources"
             xmlns:controls="clr-namespace:Booster.App.Views.Controls"
             xmlns:reports="clr-namespace:Booster.Core.Reports;assembly=Booster.Core"
             xmlns:coreres="clr-namespace:Booster.Core.Resources;assembly=Booster.Core">
  <UserControl.Resources>
    <DataTemplate x:Key="FieldRow" DataType="{x:Type reports:ReportField}">
      <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,16,0" TextWrapping="Wrap" />
        <ContentPresenter Grid.Column="1" Content="{Binding Value}" HorizontalAlignment="Left" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,16,24,4">
      <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NetworkTitle}" />
      <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.NetworkCaption}" />
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel>
        <Grid Margin="0,8,0,4" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Grid.Column="0" Content="{x:Static res:Strings.NetworkManualServer}" Target="{Binding ElementName=ManualServer}" />
          <TextBox x:Name="ManualServer" Grid.Row="0" Grid.Column="1" Width="220" Margin="8,2"
                   Text="{Binding ManualServer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{x:Static res:Strings.NetworkManualServer}" />
          <Label Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.NetworkLabel}" Target="{Binding ElementName=MeasureLabel}" />
          <TextBox x:Name="MeasureLabel" Grid.Row="1" Grid.Column="1" Width="220" Margin="8,2"
                   Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{x:Static res:Strings.NetworkLabel}" />
        </Grid>
        <WrapPanel Margin="0,4,0,4">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkMeasure}" Command="{Binding MeasureCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkCancel}" Command="{Binding CancelCommand}" />
        </WrapPanel>
        <ProgressBar Height="4" Width="320" HorizontalAlignment="Left" Margin="0,4,0,4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                     Visibility="{Binding IsMeasuring, Converter={StaticResource BooleanToVisibility}}" />
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding PhaseText}" />
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding HasMeasurement, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.NetworkServerHeading}" />
          <TextBlock Text="{Binding ServerText}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource StatusText}" Text="{Binding ServerNote}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.NetworkCandidatesHint}"
                     Visibility="{Binding Candidates.Count, Converter={StaticResource BooleanToVisibility}}" />
          <DataGrid ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                    HorizontalAlignment="Left" Margin="0,4,0,8"
                    Visibility="{Binding Candidates.Count, Converter={StaticResource BooleanToVisibility}}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnAddress}" Binding="{Binding Address}" />
              <DataGridTextColumn Header="{x:Static res:Strings.NetworkColumnEventsPerSecond}" Binding="{Binding EventsPerSecond}" />
              <DataGridTemplateColumn>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkUseCandidate}"
                            CommandParameter="{Binding Address}"
                            Command="{Binding DataContext.UseCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkBreakdownHeading}" />
          <ItemsControl ItemsSource="{Binding BreakdownRows}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource StatusText}" Text="{Binding BreakdownNote}" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkTargetsHeading}" />
          <DataGrid ItemsSource="{Binding TargetRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                    HorizontalAlignment="Left" Margin="0,4,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnTarget}" Binding="{Binding Target}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnAddress}" Binding="{Binding Address}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnLatencyMedian}" Binding="{Binding Median.Text}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.GameNetworkColumnP95}" Binding="{Binding P95.Text}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnJitter}" Binding="{Binding Jitter.Text}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnLoss}" Binding="{Binding Loss.Text}" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkRouteHeading}" />
          <TextBlock Style="{StaticResource StatusText}" Text="{Binding RouteNote}" />
          <DataGrid ItemsSource="{Binding RouteRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                    HorizontalAlignment="Left" Margin="0,4,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.GameNetworkColumnHop}" Binding="{Binding Ttl}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnAddress}" Binding="{Binding Address}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.GameNetworkColumnAddressType}" Binding="{Binding Scope}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnLatencyMedian}" Binding="{Binding Median.Text}" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkSpikesHeading}" />
          <TextBlock Text="{Binding SpikesText}" TextWrapping="Wrap" Margin="0,0,0,8" />

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkWifiHeading}" />
          <ItemsControl ItemsSource="{Binding WifiRows}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" Margin="0,4,0,4" />
          <TextBlock Style="{StaticResource StatusText}" Text="{Binding WifiText}" />
          <StackPanel Visibility="{Binding ShowLocationHint, Converter={StaticResource BooleanToVisibility}}" Margin="0,4,0,8">
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.NetworkLocationHint}" />
            <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkOpenLocationSettings}" HorizontalAlignment="Left"
                    Command="{Binding OpenSettingsCommand}" CommandParameter="privacy-location" />
          </StackPanel>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkConsumersHeading}" />
          <TextBlock Style="{StaticResource StatusText}" Text="{Binding ConsumersText}" />
          <DataGrid ItemsSource="{Binding ConsumerRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                    HorizontalAlignment="Left" Margin="0,4,0,8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnProcess}" Binding="{Binding Name}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnCategory}" Binding="{Binding Kind}" />
              <DataGridTextColumn Header="{x:Static coreres:ReportStrings.GameNetworkColumnRate}" Binding="{Binding Rate}" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkLoadHeading}" />
        <WrapPanel Margin="0,4,0,4">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkLoadStart}" Command="{Binding StartLoadTestCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkLoadContinue}" Command="{Binding ContinueLoadCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkCancel}" Command="{Binding CancelCommand}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding LoadText}" />
        <ItemsControl ItemsSource="{Binding LoadRows}" ItemTemplate="{StaticResource FieldRow}" Focusable="False" Margin="0,4,0,8" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static coreres:ReportStrings.GameNetworkComparisonHeading}" />
        <Grid Margin="0,4,0,4" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Grid.Column="0" Content="{x:Static res:Strings.NetworkBaseline}" Target="{Binding ElementName=Baseline}" />
          <ComboBox x:Name="Baseline" Grid.Row="0" Grid.Column="1" Width="460" Margin="8,2" ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding Baseline}" AutomationProperties.Name="{x:Static res:Strings.NetworkBaseline}" />
          <Label Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.NetworkCandidate}" Target="{Binding ElementName=Candidate}" />
          <ComboBox x:Name="Candidate" Grid.Row="1" Grid.Column="1" Width="460" Margin="8,2" ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding Candidate}" AutomationProperties.Name="{x:Static res:Strings.NetworkCandidate}" />
        </Grid>
        <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding HasMeasurement, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.NetworkAdviceHeading}" />
          <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding AdviceRows}" Text="{x:Static coreres:ReportStrings.EmptyList}" />
          <ItemsControl ItemsSource="{Binding AdviceRows}" Focusable="False" Margin="0,4,0,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Action}" />
                    <Button Content="{x:Static res:Strings.NetworkAdviceOpenSettings}" HorizontalAlignment="Left"
                            CommandParameter="{Binding SettingsPage}"
                            Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsPage}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.NetworkMeasurementsHeading}" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding Measurements}" Text="{x:Static res:Strings.NetworkEmpty}" />
        <DataGrid ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Left" Margin="0,4,0,8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Strings.NetworkColumnStartedAt}" Binding="{Binding StartedAt}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.GameNetworkServer}" Binding="{Binding Server}" />
            <DataGridTextColumn Header="{x:Static res:Strings.NetworkColumnLabel}" Binding="{Binding Label}" />
            <DataGridTextColumn Header="{x:Static res:Strings.NetworkColumnEnd}" Binding="{Binding End}" />
            <DataGridTemplateColumn>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.NetworkDelete}" CommandParameter="{Binding Id}"
                          Command="{Binding DataContext.DeleteMeasurementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
