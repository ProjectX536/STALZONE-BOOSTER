<UserControl x:Class="Booster.App.Views.LatencyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <!-- Трасса WPR: только по кнопке, через UAC; живые DPC и прерывания — в «Фоновой активности» -->
  <StackPanel>
    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.LatencyTitle}" />
    <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.LatencyHint}" />
    <Border HorizontalAlignment="Left" Margin="0,8,0,0">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Banner}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="{StaticResource WarningBrush}" Text="{Binding Banner}" />
    </Border>
    <WrapPanel Margin="0,4,0,4">
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.LatencyStart}" Command="{Binding StartTraceCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.LatencyStop}" Command="{Binding StopTraceCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.LatencyCancel}" Command="{Binding CancelTraceCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.LatencyDismiss}" Command="{Binding DismissTraceCommand}" />
      <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.LatencyReveal}" Command="{Binding RevealTraceCommand}" />
    </WrapPanel>
    <TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="600" Margin="0,0,0,16" />
  </StackPanel>
</UserControl>
