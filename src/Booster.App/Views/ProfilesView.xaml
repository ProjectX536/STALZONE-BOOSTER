<UserControl x:Class="Booster.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <UserControl.Resources>
    <DataTemplate x:Key="PreviewRowTemplate">
      <StackPanel Margin="0,0,0,6">
        <TextBlock TextWrapping="Wrap">
          <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Summary, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Reason}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Reason}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavProfiles}" Margin="24,16,24,0" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <!-- Замечания к пользовательским файлам профилей: видны, только если есть -->
        <StackPanel Margin="0,4,0,8" Visibility="{Binding HasLoadWarnings, Converter={StaticResource BooleanToVisibility}}">
          <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{x:Static res:Strings.ProfileLoadWarningsTitle}" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding LoadWarnings}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Профиль -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Label Content="{x:Static res:Strings.ProfileLabel}" Target="{Binding ElementName=ProfilePicker}" Padding="0" VerticalAlignment="Center" />
          <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                    Width="300" Margin="8,0,0,0" AutomationProperties.Name="{x:Static res:Strings.ProfileLabel}" />
        </StackPanel>

        <!-- Сессия -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SessionTitle}" />
        <Border Style="{StaticResource Card}" DataContext="{Binding Session}">
          <StackPanel>
            <!-- Нет сессии -->
            <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BooleanToVisibility}}">
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.PrepareSession}" Command="{Binding PrepareCommand}"
                      HorizontalAlignment="Left" />
              <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.PrepareHint}" />

              <!-- Подтверждение -->
              <StackPanel Visibility="{Binding IsPreviewing, Converter={StaticResource BooleanToVisibility}}" Margin="0,8,0,0">
                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ConfirmTitle}" Margin="0,4,0,4" />
                <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding ConfirmActions}" Text="{x:Static res:Strings.NoneInGroup}" />
                <ItemsControl ItemsSource="{Binding ConfirmActions}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,8">
                        <CheckBox IsChecked="{Binding IsConfirmed}" AutomationProperties.Name="{Binding Name}">
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Summary, Mode=OneWay}" />
                          </TextBlock>
                        </CheckBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,0"
                                   Text="{Binding Risk, StringFormat={x:Static res:Strings.RiskFormat}}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,0"
                                   Text="{Binding Undo, StringFormat={x:Static res:Strings.UndoFormat}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.AutoTitle}" Margin="0,8,0,4" />
                <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding AutoActions}" Text="{x:Static res:Strings.NoneInGroup}" />
                <ItemsControl ItemsSource="{Binding AutoActions}" ItemTemplate="{StaticResource PreviewRowTemplate}" Focusable="False" />

                <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SkippedTitle}" Margin="0,8,0,4" />
                <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding SkippedActions}" Text="{x:Static res:Strings.NoneInGroup}" />
                <ItemsControl ItemsSource="{Binding SkippedActions}" ItemTemplate="{StaticResource PreviewRowTemplate}" Focusable="False" />

                <TextBlock Text="{x:Static res:Strings.NothingToApply}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding NothingToApply, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{x:Static res:Strings.PreparationHint}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding HasPreparationConfirmed, Converter={StaticResource BooleanToVisibility}}" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.WaitForGame}" Command="{Binding ArmCommand}" />
                  <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelPreviewCommand}" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>

            <!-- Подготовлено -->
            <StackPanel Visibility="{Binding IsArmed, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="{Binding ArmedText}" TextWrapping="Wrap" />
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.CancelPreparation}" Command="{Binding DisarmCommand}"
                      HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Идёт сессия -->
            <StackPanel Visibility="{Binding IsInSession, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="{Binding StateText, StringFormat={x:Static res:Strings.SessionStateFormat}}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameText, StringFormat={x:Static res:Strings.SessionGameFormat}}" />
              <TextBlock Text="{Binding LoadText}" />
              <ItemsControl ItemsSource="{Binding SensorLines}" Focusable="False" />
              <TextBlock Text="{Binding ThrottleText}" TextWrapping="Wrap" />
              <TextBlock Text="{x:Static res:Strings.SessionCoolingHint}" FontWeight="SemiBold" TextWrapping="Wrap"
                         Visibility="{Binding ShowCoolingHint, Converter={StaticResource BooleanToVisibility}}" />
              <TextBlock Text="{Binding FramesText}" TextWrapping="Wrap" />
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SessionChangesTitle}" Margin="0,8,0,4" />
              <ItemsControl ItemsSource="{Binding Changes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Summary, Mode=OneWay}" />
                      <Run Text="—" /> <Run Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.StopSession}" Command="{Binding StopSessionCommand}"
                      HorizontalAlignment="Left" Margin="0,8,0,0" />
              <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.FutureTelemetryNote}" />
            </StackPanel>

            <TextBlock Style="{StaticResource StatusText}" Text="{Binding PreparationText}" />
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Игры -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.GamesTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.GamesHint}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding Games}" Text="{x:Static res:Strings.NoGames}" />
        <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding}" Width="300" VerticalAlignment="Center" />
                <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Remove}"
                        Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding StringFormat={x:Static res:Strings.RemoveGameFormat}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <ComboBox ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding SelectedProcess}" Width="460"
                    AutomationProperties.Name="{x:Static res:Strings.AddFromWindows}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock TextTrimming="CharacterEllipsis">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{x:Static res:Strings.ProcessItemFormat}">
                      <Binding Path="Name" />
                      <Binding Path="WindowTitle" />
                      <Binding Path="ProcessId" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.AddFromWindows}" Command="{Binding AddRunningGameCommand}"
                  Margin="8,0,0,0" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.RefreshList}" Command="{Binding RefreshProcessesCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Label Content="{x:Static res:Strings.GameNameLabel}" Target="{Binding ElementName=GameName}" Padding="0" VerticalAlignment="Center" />
          <TextBox x:Name="GameName" Text="{Binding NewGameName, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="8,0,0,0"
                   AutomationProperties.Name="{x:Static res:Strings.GameNameLabel}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.AddByName}" Command="{Binding AddTypedGameCommand}"
                  Margin="8,0,0,0" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ExeExample}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Действия -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.ActionsTitle}" />
        <ItemsControl ItemsSource="{Binding Actions}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource Hint}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{x:Static res:Strings.ActionModeLevelFormat}">
                        <Binding Path="ModeText" />
                        <Binding Path="LevelText" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Risk, StringFormat={x:Static res:Strings.RiskFormat}}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Undo, StringFormat={x:Static res:Strings.UndoFormat}}" TextWrapping="Wrap" />
                  <CheckBox Content="{x:Static res:Strings.EnableAction}" IsChecked="{Binding IsEnabled}" Margin="0,6,0,0"
                            AutomationProperties.Name="{Binding Name}"
                            Visibility="{Binding IsOptional, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.RecommendationsTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.RecommendationsHint}" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Recommendations}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                <Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Фоновые приложения -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.BackgroundAppsTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.BackgroundAppsCaption}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding BackgroundApps}" Text="{x:Static res:Strings.NoBackgroundApps}" />
        <ItemsControl ItemsSource="{Binding BackgroundApps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding Name}" Width="300" VerticalAlignment="Center" />
                <CheckBox Content="{x:Static res:Strings.AllowClose}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.AllowCloseFormat}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Автозапуск и сохранение -->
        <CheckBox Content="{x:Static res:Strings.AutoStartLabel}" IsChecked="{Binding AutoStart}" Margin="0,16,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.AutoStartHint}" Margin="20,2,0,0" />
        <WrapPanel Margin="0,16,0,0">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
