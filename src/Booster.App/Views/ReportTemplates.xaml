<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:reports="clr-namespace:Booster.Core.Reports;assembly=Booster.Core"
                    xmlns:controls="clr-namespace:Booster.App.Views.Controls"
                    xmlns:converters="clr-namespace:Booster.App.Converters">

  <SolidColorBrush x:Key="UnavailableBrush" Color="#6B6B6B" />
  <SolidColorBrush x:Key="WarningBrush" Color="#A4262C" />
  <SolidColorBrush x:Key="InfoBrush" Color="#005A9E" />
  <SolidColorBrush x:Key="NoteBrush" Color="#555555" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="HeaderBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="FlaggedRowBrush" Color="#FDE7E9" />

  <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  <converters:InverseBooleanConverter x:Key="InverseBoolean" />

  <sys:Double x:Key="CellMaxWidth">460</sys:Double>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>

  <Style x:Key="ToolbarButton" TargetType="Button">
    <Setter Property="Padding" Value="14,4" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="MinWidth" Value="96" />
  </Style>

  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="900" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Style.Triggers>
      <Trigger Property="Text" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
    <Setter Property="Foreground" Value="{StaticResource NoteBrush}" />
  </Style>

  <Style x:Key="EmptyHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag.Count, RelativeSource={RelativeSource Self}}" Value="0">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="ReportTableFrame" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="ReportDataCell" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style x:Key="ReportHeaderCell" TargetType="Border" BasedOn="{StaticResource ReportDataCell}">
    <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
  </Style>

  <Style x:Key="ReportFlaggedCell" TargetType="Border" BasedOn="{StaticResource ReportDataCell}">
    <Setter Property="Background" Value="{StaticResource FlaggedRowBrush}" />
  </Style>

  <DataTemplate DataType="{x:Type reports:ReportCell}">
    <Grid>
      <TextBlock x:Name="Text" Text="{Binding Text}" ToolTip="{Binding Tooltip}" TextWrapping="Wrap"
                 MaxWidth="{DynamicResource CellMaxWidth}" />
      <ItemsControl x:Name="Links" ItemsSource="{Binding Links}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock>
              <Hyperlink NavigateUri="{Binding Url}" ToolTip="{Binding Url}">
                <Run Text="{Binding Title, Mode=OneWay}" />
              </Hyperlink>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <DataTemplate.Triggers>
      <Trigger SourceName="Links" Property="HasItems" Value="False">
        <Setter TargetName="Links" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static reports:CellTone.Unavailable}">
        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource UnavailableBrush}" />
        <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static reports:CellTone.Warning}">
        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static reports:CellTone.Info}">
        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource InfoBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="{x:Static reports:CellTone.Note}">
        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource NoteBrush}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate DataType="{x:Type reports:ReportHeading}">
    <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type reports:ReportParagraph}">
    <ContentPresenter Content="{Binding Content}" Margin="0,2,0,8" HorizontalAlignment="Left">
      <ContentPresenter.Resources>
        <sys:Double x:Key="CellMaxWidth">900</sys:Double>
      </ContentPresenter.Resources>
    </ContentPresenter>
  </DataTemplate>

  <DataTemplate DataType="{x:Type reports:ReportFieldList}">
    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,2,0,8">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type reports:ReportField}">
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,16,0" TextWrapping="Wrap" />
            <ContentPresenter Grid.Column="1" Content="{Binding Value}" HorizontalAlignment="Left" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <DataTemplate DataType="{x:Type reports:ReportTable}">
    <controls:ReportTableGrid Table="{Binding}" Margin="0,4,0,10" HorizontalAlignment="Left" />
  </DataTemplate>

  <DataTemplate DataType="{x:Type reports:ReportSection}">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
      <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
