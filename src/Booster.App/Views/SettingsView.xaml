<UserControl x:Class="Booster.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavSettings}" Margin="24,16,24,0" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.PresentMonTitle}" Margin="0,4,0,6" />
        <Label Content="{x:Static res:Strings.PresentMonPathLabel}" Target="{Binding ElementName=PresentMonPath}" Padding="0,0,0,4" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Browse}"
                  Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
          <TextBox x:Name="PresentMonPath" Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}" MinWidth="420"
                   VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.PresentMonPathLabel}" />
        </DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.PresentMonPathHint}" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Label Content="{x:Static res:Strings.DefaultDurationLabel}" Target="{Binding ElementName=DefaultDuration}" Padding="0"
                 VerticalAlignment="Center" />
          <TextBox x:Name="DefaultDuration" Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="8,0,0,0"
                   AutomationProperties.Name="{x:Static res:Strings.DefaultDurationLabel}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.DurationRule}" />

        <WrapPanel Margin="0,16,0,0">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
        <TextBlock Style="{StaticResource Hint}" Text="{Binding SettingsFileText}" Margin="0,8,0,0" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.ConfigWarningsTitle}" />
        <TextBlock Text="{x:Static res:Strings.NoConfigWarnings}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Warnings.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
