<UserControl x:Class="Booster.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources"
             xmlns:controls="clr-namespace:Booster.App.Views.Controls"
             xmlns:vm="clr-namespace:Booster.App.ViewModels">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavPerformance}" Margin="24,16,24,0" />

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.CaptureTitle}" Margin="0,4,0,6" />
        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="{x:Static res:Strings.ReadinessChecking}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Readiness}" Value="{x:Static vm:CaptureReadiness.NotInstalled}">
                  <Setter Property="Text" Value="{x:Static res:Strings.ReadinessNotInstalled}" />
                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Readiness}" Value="{x:Static vm:CaptureReadiness.NeedsElevation}">
                  <Setter Property="Text" Value="{x:Static res:Strings.ReadinessNeedsElevation}" />
                  <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Readiness}" Value="{x:Static vm:CaptureReadiness.Ready}">
                  <Setter Property="Text" Value="{x:Static res:Strings.ReadinessReady}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Readiness}" Value="{x:Static vm:CaptureReadiness.CheckFailed}">
                  <Setter Property="Text" Value="{x:Static res:Strings.ReadinessCheckFailed}" />
                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{x:Static res:Strings.PresentMonInstallHint}" Margin="0,4,0,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Readiness}" Value="{x:Static vm:CaptureReadiness.NotInstalled}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource Hint}" Text="{Binding PresentMonText}" />
        <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.CheckAgain}" Command="{Binding CheckReadinessCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0" />

        <StackPanel IsEnabled="{Binding StartCommand.IsRunning, Converter={StaticResource InverseBoolean}}">
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.TargetTitle}" />
          <RadioButton Content="{x:Static res:Strings.TargetWindow}" IsChecked="{Binding UseWindowList}" />
          <StackPanel Orientation="Horizontal" Margin="22,4,0,10" IsEnabled="{Binding UseWindowList}">
            <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Width="460"
                      AutomationProperties.Name="{x:Static res:Strings.TargetWindow}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{x:Static res:Strings.ProcessItemFormat}">
                        <Binding Path="Name" />
                        <Binding Path="WindowTitle" />
                        <Binding Path="ProcessId" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.RefreshList}" Command="{Binding RefreshProcessesCommand}"
                    Margin="8,0,0,0" />
          </StackPanel>
          <RadioButton Content="{x:Static res:Strings.TargetExe}" IsChecked="{Binding UseWindowList, Converter={StaticResource InverseBoolean}}" />
          <StackPanel Orientation="Horizontal" Margin="22,4,0,10"
                      IsEnabled="{Binding UseWindowList, Converter={StaticResource InverseBoolean}}">
            <TextBox Text="{Binding ExecutableName, UpdateSourceTrigger=PropertyChanged}" Width="300"
                     AutomationProperties.Name="{x:Static res:Strings.TargetExe}" />
            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ExeExample}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SeriesTitle}" />
          <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static res:Strings.RunCountLabel}" Target="{Binding ElementName=RunCount}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="RunCount" Grid.Row="0" Grid.Column="1" Text="{Binding RunCountText, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.RunCountLabel}" />
            <Label Grid.Row="1" Grid.Column="0" Content="{x:Static res:Strings.RunSecondsLabel}" Target="{Binding ElementName=RunSeconds}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="RunSeconds" Grid.Row="1" Grid.Column="1" Text="{Binding RunSecondsText, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.RunSecondsLabel}" />
            <Label Grid.Row="2" Grid.Column="0" Content="{x:Static res:Strings.PauseSecondsLabel}" Target="{Binding ElementName=PauseSeconds}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="PauseSeconds" Grid.Row="2" Grid.Column="1" Text="{Binding PauseSecondsText, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.PauseSecondsLabel}" />
            <Label Grid.Row="3" Grid.Column="0" Content="{x:Static res:Strings.StartDelayLabel}" Target="{Binding ElementName=StartDelay}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="StartDelay" Grid.Row="3" Grid.Column="1" Text="{Binding StartDelayText, UpdateSourceTrigger=PropertyChanged}"
                     Width="80" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.StartDelayLabel}" />

            <Label Grid.Row="0" Grid.Column="3" Content="{x:Static res:Strings.GraphicsProfileLabel}" Target="{Binding ElementName=GraphicsProfile}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="GraphicsProfile" Grid.Row="0" Grid.Column="4" Text="{Binding GraphicsProfile, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.GraphicsProfileLabel}" />
            <Label Grid.Row="1" Grid.Column="3" Content="{x:Static res:Strings.SceneLabel}" Target="{Binding ElementName=Scene}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="Scene" Grid.Row="1" Grid.Column="4" Text="{Binding Scene, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.SceneLabel}" />
            <Label Grid.Row="2" Grid.Column="3" Content="{x:Static res:Strings.WindowModeLabel}" Target="{Binding ElementName=WindowMode}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="WindowMode" Grid.Row="2" Grid.Column="4" Text="{Binding WindowMode, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.WindowModeLabel}" />
            <Label Grid.Row="3" Grid.Column="3" Content="{x:Static res:Strings.ChangeNoteLabel}" Target="{Binding ElementName=ChangeNote}"
                   Padding="0" VerticalAlignment="Center" />
            <TextBox x:Name="ChangeNote" Grid.Row="3" Grid.Column="4" Text="{Binding ChangeNote, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Margin="8,2" AutomationProperties.Name="{x:Static res:Strings.ChangeNoteLabel}" />
          </Grid>
          <TextBlock Style="{StaticResource Hint}" Text="{Binding LimitsText}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.NotesHint}" />
          <CheckBox Content="{x:Static res:Strings.SoundCuesLabel}" IsChecked="{Binding SoundCues}" Margin="0,8,0,0" />
        </StackPanel>

        <WrapPanel Margin="0,12,0,0">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.StartSeries}" Command="{Binding StartCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.CancelSeries}" Command="{Binding StartCancelCommand}"
                  Visibility="{Binding StartCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
        </WrapPanel>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.ProgressTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.ProgressHint}" />
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar IsIndeterminate="True" Height="4" Width="320" HorizontalAlignment="Left" Margin="0,8,0,0"
                     Visibility="{Binding StartCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.ResultTitle}" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding BenchmarkBlocks}" Text="{x:Static res:Strings.ResultPending}" />
        <ItemsControl ItemsSource="{Binding BenchmarkBlocks}" Focusable="False" HorizontalAlignment="Left" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.HistoryTitle}" />
        <WrapPanel>
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.RefreshHistory}" Command="{Binding RefreshHistoryCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.SetBaseline}" Command="{Binding SetBaselineCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.ClearBaseline}" Command="{Binding ClearBaselineCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.DeleteSeries}" Command="{Binding AskDeleteCommand}" />
        </WrapPanel>
        <Border Style="{StaticResource Card}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="{StaticResource WarningBrush}"
                       Text="{x:Static res:Strings.DeleteSeriesConfirm}" />
            <WrapPanel Margin="0,8,0,0">
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.DeleteSeriesConfirmButton}"
                      Command="{Binding DeleteSeriesCommand}" />
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelDeleteCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Hint}" Text="{Binding BaselineText}" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding History}" Text="{x:Static res:Strings.HistoryEmpty}" />
        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSeries}" SelectionMode="Single" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal" HorizontalAlignment="Left" MaxHeight="320" Margin="0,4,0,16"
                  AutomationProperties.Name="{x:Static res:Strings.HistoryTitle}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Strings.HistoryColumnDate}" Binding="{Binding StartedAt}" SortMemberPath="Series.StartedAt" />
            <DataGridTextColumn Header="{x:Static res:Strings.HistoryColumnGame}" Binding="{Binding Target}" />
            <DataGridTextColumn Header="{x:Static res:Strings.HistoryColumnChange}" Binding="{Binding Change}" />
            <DataGridTextColumn Header="{x:Static res:Strings.HistoryColumnAverageFps}" Binding="{Binding AverageFps}" />
            <DataGridTextColumn Header="{x:Static res:Strings.HistoryColumnOnePercentLow}" Binding="{Binding OnePercentLow}" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ComparisonTitle}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ComparisonBlocks.Count}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding ComparisonBlocks}" Focusable="False" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
