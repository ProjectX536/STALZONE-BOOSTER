<UserControl x:Class="Booster.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavJournal}" Margin="24,16,24,0" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <!-- Отчёт восстановления при запуске -->
        <Border Style="{StaticResource Card}" Margin="0,4,0,0"
                Visibility="{Binding HasRecoveryReport, Converter={StaticResource BooleanToVisibility}}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.RecoveryBannerTitle}" Margin="0,0,0,6" />

            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RecoveredSessions.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.RecoveredTitle}" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding RecoveredSessions}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding PendingSessions}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static res:Strings.PendingTitle}" Margin="0,2,0,4" />
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="12,0,0,2" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Recover}" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,8,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.ProblemsTitle}" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Сессии -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SessionsTitle}" />
        <WrapPanel>
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Refresh}" Command="{Binding LoadCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.RevertMaintenance}" Command="{Binding RevertMaintenanceCommand}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusMessage}" />
        <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MaxHeight="240" Margin="0,8,0,0"
                 AutomationProperties.Name="{x:Static res:Strings.SessionsTitle}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="6,4" />
              <Setter Property="AutomationProperties.Name" Value="{Binding DateText}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <TextBlock.Text>
                  <MultiBinding StringFormat="{x:Static res:Strings.SessionRowFormat}">
                    <Binding Path="DateText" />
                    <Binding Path="KindText" />
                    <Binding Path="ProfileName" />
                    <Binding Path="GameName" />
                    <Binding Path="OutcomeText" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Выбранная сессия -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SelectedChangesTitle}" />
          <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding SelectedChanges}" Text="{x:Static res:Strings.NoneInGroup}" />
          <ItemsControl ItemsSource="{Binding SelectedChanges}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Summary, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText, StringFormat={x:Static res:Strings.ChangeStatusFormat}}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Detail}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding VerifiedText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SkippedActionsTitle}" />
          <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding SelectedSkipped}" Text="{x:Static res:Strings.NoneInGroup}" />
          <ItemsControl ItemsSource="{Binding SelectedSkipped}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Reason, Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
