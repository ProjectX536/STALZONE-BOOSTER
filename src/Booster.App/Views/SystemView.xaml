<UserControl x:Class="Booster.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Booster.App.Resources"
             xmlns:controls="clr-namespace:Booster.App.Views.Controls"
             xmlns:views="clr-namespace:Booster.App.Views"
             xmlns:reports="clr-namespace:Booster.Core.Reports;assembly=Booster.Core"
             xmlns:coreres="clr-namespace:Booster.Core.Resources;assembly=Booster.Core">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,16,24,4">
      <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.NavSystem}" />
      <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemHint}" />
      <TextBlock Text="{x:Static res:Strings.Collecting}" Margin="0,8,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasData}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SystemActivityTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemActivityHint}" />
        <ItemsControl ItemsSource="{Binding Pressure}" Focusable="False" Margin="0,4,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type reports:ReportField}">
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="260" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,16,0" TextWrapping="Wrap" />
                <ContentPresenter Grid.Column="1" Content="{Binding Value}" HorizontalAlignment="Left" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding ActivityStatus}" Margin="0,0,0,8">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ActivityStatus}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SystemTopIoTitle}" Margin="0,4,0,0" />
        <DataGrid ItemsSource="{Binding TopIo}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Left" Margin="0,4,0,12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnProcess}" Binding="{Binding Process}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnPid}" Binding="{Binding ProcessId}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnRead}" Binding="{Binding Read}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnWrite}" Binding="{Binding Write}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnHardFaults}" Binding="{Binding HardFaults}" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SystemTopHardFaultsTitle}" />
        <DataGrid ItemsSource="{Binding TopHardFaults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Left" Margin="0,4,0,16">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnProcess}" Binding="{Binding Process}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnPid}" Binding="{Binding ProcessId}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnHardFaults}" Binding="{Binding HardFaults}" />
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnRead}" Binding="{Binding Read}" />
          </DataGrid.Columns>
        </DataGrid>

        <views:LatencyPanel DataContext="{Binding Latency}" />

        <views:HagsPanel DataContext="{Binding Hags}" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SystemNetworkTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemNetworkHint}" />
        <WrapPanel Margin="0,4,0,4">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.SystemNetworkRun}"
                  Command="{Binding RunNetworkTestCommand}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding RunNetworkTestCancelCommand}"
                  Visibility="{Binding RunNetworkTestCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.SystemOpenGameNetwork}"
                  Command="{Binding OpenGameNetworkCommand}" />
        </WrapPanel>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding NetworkStatus}" Margin="0,0,0,16" />

        <ItemsControl ItemsSource="{Binding Sections}" Focusable="False" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SystemMaintenanceTitle}" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemMaintenanceHint}" />

        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SystemStartupActionsTitle}" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemStartupActionsHint}" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding StartupRows}" Text="{x:Static res:Strings.SystemStartupActionsEmpty}" />
        <DataGrid ItemsSource="{Binding StartupRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Left" Margin="0,4,0,12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnStartupItem}" Binding="{Binding Name}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnStartupLocation}" Binding="{Binding Location}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnState}" Binding="{Binding State}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnPrivateBytes}" Binding="{Binding Memory}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnVerdict}" Binding="{Binding Verdict}" />
            <DataGridTemplateColumn>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.DisableStartupItem}"
                          IsEnabled="{Binding CanDisable}" CommandParameter="{Binding}"
                          ToolTip="{Binding DisableHint}" ToolTipService.ShowOnDisabled="True"
                          Command="{Binding DataContext.RequestDisableStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.SystemTweakActionsTitle}" />
        <TextBlock Style="{StaticResource EmptyHint}" Tag="{Binding TweakRows}" Text="{x:Static res:Strings.SystemTweakActionsEmpty}" />
        <DataGrid ItemsSource="{Binding TweakRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  controls:TableSorting.IsEnabled="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                  HorizontalAlignment="Left" Margin="0,4,0,8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnTweak}" Binding="{Binding Name}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnState}" Binding="{Binding State}" />
            <DataGridTextColumn Header="{x:Static coreres:ReportStrings.ColumnTweakBasis}" Binding="{Binding Evidence}" MaxWidth="480">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTemplateColumn>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.ApplyTweak}"
                          IsEnabled="{Binding CanApply}" CommandParameter="{Binding}"
                          Command="{Binding DataContext.RequestApplyTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <Border HorizontalAlignment="Left" Margin="0,8,0,0">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PendingConfirmation}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel>
            <TextBlock TextWrapping="Wrap" MaxWidth="600" Foreground="{StaticResource WarningBrush}" Text="{Binding PendingConfirmation}" />
            <WrapPanel Margin="0,8,0,0">
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.MaintenanceConfirmButton}"
                      Command="{Binding ConfirmMaintenanceCommand}" />
              <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelMaintenanceCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource StatusText}" Text="{Binding MaintenanceStatus}" TextWrapping="Wrap" MaxWidth="600" Margin="0,4,0,8" />

        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:Strings.SystemSettingsLinksTitle}" />
        <WrapPanel Margin="0,4,0,16">
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.OpenGameModeSettings}"
                  Command="{Binding OpenGamingSettingsCommand}" CommandParameter="gaming-gamemode" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.OpenGameDvrSettings}"
                  Command="{Binding OpenGamingSettingsCommand}" CommandParameter="gaming-gamedvr" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.OpenGameBarSettings}"
                  Command="{Binding OpenGamingSettingsCommand}" CommandParameter="gaming-gamebar" />
          <Button Style="{StaticResource ToolbarButton}" Content="{x:Static res:Strings.OpenGraphicsSettings}"
                  Command="{Binding OpenGamingSettingsCommand}" CommandParameter="display-advancedgraphics" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
